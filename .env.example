# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
LLM_PROVIDER=anthropic          # anthropic | vllm | mock
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5
APP_VERSION=0.1.0

API_KEYS=dev-key,teammate-key
ADMIN_KEY=change-me
RATE_LIMIT_PER_MIN=30
DAILY_QUOTA=500

EMBEDDER=fastembed
CACHE_THRESHOLD=0.90
CACHE_TTL_S=86400
CACHE_VERSION=v1

# USD per 1M tokens - copy current numbers from the provider's pricing page
INPUT_PRICE_PER_MTOK=1.0
OUTPUT_PRICE_PER_MTOK=5.0
